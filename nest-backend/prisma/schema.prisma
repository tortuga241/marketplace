generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//ACCOUNT_TAB
model Account {
  id           String   @id @default(uuid())
  login        String   @unique
  password     String
  email        String   @unique
  key          String   @unique
  shop         Shop?
  boughtOrders Order[] @relation("BuyerOrders")
  soldOrders   Order[] @relation("SellerOrders")
  isVerified   Boolean  @default(false)
  verifyToken  String?
}

//ACCOUNT_VERIFY_TAB
model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  login     String
  password  String
  key       String
  code      String
  createdAt DateTime @default(now())
}

//SHOP_TAB
model Shop {
  id          String   @id @default(uuid())
  ownerId     String   @unique
  type        String
  title       String
  description String
  owner       Account  @relation(fields: [ownerId], references: [id])
  phone       String
  lots        Lot[]
  orders      Order[]
  createdAt   DateTime @default(now())
}

//LOT_TAB
model Lot {
  id          String   @id @default(uuid())
  shopId      String
  accountId   String
  type        String
  cost        String
  title       String
  description String
  shop        Shop   @relation(fields: [shopId], references: [id])
  orders      Order[]
  createdAt   DateTime @default(now())
}

//ORDER_TAB
model Order {
  id              String    @id @default(uuid())
  code            String    @unique
  lotId           String    
  lotSnapshot     Json?     
  sellerAccountId String    
  shopId          String    
  buyerAccountId  String    
  cost            Float     
  status          String    
  lot             Lot       @relation(fields: [lotId], references: [id])
  shop            Shop      @relation(fields: [shopId], references: [id])
  buyer           Account   @relation("BuyerOrders", fields: [buyerAccountId], references: [id])
  seller          Account   @relation("SellerOrders", fields: [sellerAccountId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

//ORDER_VERIFY_TAB
model OrderVerification {
  id                String    @id @default(uuid())
  verificationCode  String 
  expiresAt         DateTime  
  lotId             String
  sellerAccountId   String
  shopId            String
  buyerAccountId    String
  lotSnapshot       Json?
  cost              Float
  status            String    
  buyerEmail        String    
  createdAt         DateTime  @default(now())
}

model Article {
  id          String   @id @default(uuid())
  title       String
  type        String
  description String
  cost        String
}

model Review {
  id          String   @id @default(uuid())
  accountId   String
  shopId      String
  lotId       String?
  articleId   String?
  rating      Int
  description String
  createdAt   DateTime @default(now())
}

model Chat {
  id        String   @id @default(uuid())
  buyerId   String
  sellerId  String
  messageId String
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())
}

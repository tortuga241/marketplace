generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//ACCOUNT_TAB
model Account {
  id          String   @id @default(uuid())
  login       String   @unique
  password    String
  email       String   @unique
  key         String   @unique
  shop        Shop?
  isVerified  Boolean  @default(false)
  verifyToken String?
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  login     String
  password  String
  key       String
  code      String
  createdAt DateTime @default(now())
}

model Shop {
  id          String   @id @default(uuid())
  ownerId     String   @unique
  type        String
  title       String
  description String
  owner       Account  @relation(fields: [ownerId], references: [id])
  phone       String
  createdAt   DateTime @default(now())
}

model Lot {
  id          String   @id @default(uuid())
  shopId      String
  accountId   String
  type        String
  cost        String
  title       String
  description String
}

model Article {
  id          String   @id @default(uuid())
  title       String
  type        String
  description String
  cost        String
}

model Review {
  id          String   @id @default(uuid())
  accountId   String
  shopId      String
  lotId       String?
  articleId   String?
  rating      Int
  description String
  createdAt   DateTime @default(now())
}

model Order {
  id        String   @id @default(uuid())
  code      String   @unique
  shopId    String
  accountId String
  cost      String
  status    String
  createdAt DateTime @default(now())
}

model Chat {
  id        String   @id @default(uuid())
  buyerId   String
  sellerId  String
  messageId String
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())
}

    "/reviews": {
      "post": {
        "operationId": "ReviewController_createReview",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewsDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Отзыв успешно создан."
          },
          "400": {
            "description": "Неверный запрос (напр., отзыв уже существует)."
          },
          "401": {
            "description": "Пользователь не авторизован."
          },
          "404": {
            "description": "Магазин или лот не найден."
          },
          "500": {
            "description": "Внутренняя ошибка сервера."
          }
        },
        "summary": "Создать новый отзыв",
        "tags": [
          "Reviews (Отзывы)"
        ]
      }
    },
    "/reviews/shop/{shopId}": {
      "get": {
        "operationId": "ReviewController_getReviewsForShop",
        "parameters": [
          {
            "name": "shopId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список отзывов успешно получен."
          },
          "404": {
            "description": "Магазин не найден."
          }
        },
        "summary": "Получить все отзывы для магазина (продавца)",
        "tags": [
          "Reviews (Отзывы)"
        ]
      }
    },
    "/reviews/lot/{lotId}": {
      "get": {
        "operationId": "ReviewController_getReviewsForLot",
        "parameters": [
          {
            "name": "lotId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список отзывов успешно получен."
          },
          "404": {
            "description": "Лот не найден."
          }
        },
        "summary": "Получить все отзывы для конкретного товара (лота)",
        "tags": [
          "Reviews (Отзывы)"
        ]
      }
    },
    "/reviews/{reviewId}": {
      "delete": {
        "operationId": "ReviewController_deleteReview",
        "parameters": [
          {
            "name": "reviewId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Отзыв успешно удален."
          },
          "401": {
            "description": "Пользователь не авторизован."
          },
          "403": {
            "description": "У пользователя нет прав на удаление этого отзыва."
          },
          "404": {
            "description": "Отзыв не найден."
          }
        },
        "summary": "Удалить отзыв",
        "tags": [
          "Reviews (Отзывы)"
        ]
      }
    }
  },
  "info": {
    "title": "Market API",
    "description": "Документация к моему API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "users",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "RequestRegisterDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "example": "Bob",
            "description": "Login пользователя"
          },
          "email": {
            "type": "string",
            "example": "example@gmail.com",
            "description": "Email пользователя"
          },
          "password": {
            "type": "string",
            "example": "qwerty",
            "description": "Password пользователя"
          }
        },
        "required": [
          "login",
          "email",
          "password"
        ]
      },
      "VerifyRegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "expamle@gmail.com",
            "description": "Email пользователя"
          },
          "code": {
            "type": "string",
            "example": "321654",
            "description": "Code подтверждения с почты"
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "example@gmail.com",
            "description": "Email пользователя"
          },
          "password": {
            "type": "string",
            "example": "strongPassword123",
            "description": "Пароль пользователя"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "OpenShopDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "DocsShop",
            "description": "Название магазина"
          },
          "type": {
            "type": "string",
            "example": "Docs",
            "description": "Тип магазина"
          },
          "description": {
            "type": "string",
            "example": "The best shop",
            "description": "Описание магазина"
          },
          "phone": {
            "type": "string",
            "example": "+ 777 333 68 07",
            "description": "Номер телефона продавца"
          }
        },
        "required": [
          "title",
          "type",
          "description",
          "phone"
        ]
      },
      "LotDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Курс по WEB разработке",
            "description": "Название продукта"
          },
          "cost": {
            "type": "string",
            "example": "20.000₸",
            "description": "Стоимость продукта"
          },
          "type": {
            "type": "string",
            "example": "Видео",
            "description": "Тип продукта"
          },
          "description": {
            "type": "string",
            "example": "Углубленный курс по WEB разработке",
            "description": "Описание продукта"
          }
        },
        "required": [
          "title",
          "cost",
          "type",
          "description"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "lotId": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-1234-567890abcdef",
            "description": "ID лота, который хотят купить"
          }
        },
        "required": [
          "lotId"
        ]
      },
      "CompleteOrderDto": {
        "type": "object",
        "properties": {
          "verificationId": {
            "type": "string",
            "description": "ID записи о верификации (из /initiate)"
          },
          "code": {
            "type": "string",
            "description": "6-значный код из письма"
          }
        },
        "required": [
          "verificationId",
          "code"
        ]
      },
      "ResendCodeDto": {
        "type": "object",
        "properties": {
          "verificationId": {
            "type": "string",
            "description": "ID записи о верификации (из /initiate)"
          }
        },
        "required": [
          "verificationId"
        ]
      },
      "ReviewsDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "example": "Качество на высоте, автор реально крут!",
            "description": "Text-content отзыва"
          },
          "rating": {
            "type": "number",
            "example": "5",
            "description": "Рейтинг от 1 до 5"
          },
          "shopId": {
            "type": "string",
            "example": "uuid-shop-123",
            "description": "ID магазина (продавца), к которому отзыв"
          },
          "lotId": {
            "type": "string",
            "example": "uuid-lot-456",
            "description": "ID лота (если отзыв о лоте)"
          }
        },
        "required": [
          "description",
          "rating",
          "shopId"
        ]
      }
    }
  }
}
      }
    },
    "/lots/create": {
      "post": {
        "operationId": "LotController_lot",
        "parameters": [
          {
            "name": "x-shop-id",
            "required": true,
            "in": "header",
            "description": "Уникальный ID магазина",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-account-id",
            "required": true,
            "in": "header",
            "description": "Уникальный ID аккаунта владельца",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LotDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Лот успешно создан!"
          },
          "400": {
            "description": "Не переданы обязательные заголовки x-shop-id или x-account-id."
          },
          "401": {
            "description": "Ошибка авторизации (магазин/аккаунт не найден или не является владельцем)"
          }
        },
        "summary": "Запрос на создание лота",
        "tags": [
          "Lot"
        ]
      }
    },
    "/lots": {
      "get": {
        "operationId": "LotController_getAllLots",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Список всех лотов успешно получен."
          },
          "500": {
            "description": "Внутренняя ошибка сервера."
          }
        },
        "summary": "Получение всех лотов (для каталога)",
        "tags": [
          "Lot"
        ]
      }
    },
    "/lots/{id}": {
      "get": {
        "operationId": "LotController_getLotById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Уникальный ID лота (UUID)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Лот успешно найден."
          },
          "400": {
            "description": "Неверный формат ID."
          },
          "404": {
            "description": "Лот с указанным ID не найден."
          }
        },
        "summary": "Получение одного лота по ID",
        "tags": [
          "Lot"
        ]
      },
      "delete": {
        "operationId": "LotController_deleteOrHideLotById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Уникальный ID лота (UUID)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Лот успешно удален"
          },
          "401": {
            "description": "Пользователь не авторизован"
          },
          "403": {
            "description": "Нет прав для удаления (не владелец)"
          },
          "404": {
            "description": "Лот с указанным ID не найден"
          }
        },
        "summary": "Удаление одного лота по ID (только владельцем)",
        "tags": [
          "Lot"
        ]
      }
    },
    "/lots/by-account/{accountId}": {
      "get": {
        "operationId": "LotController_getLotsByAccountId",
        "parameters": [
          {
            "name": "accountId",
            "required": true,
            "in": "path",
            "description": "Уникальный ID аккаунта продавца",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список лотов продавца успешно получен."
          },
          "404": {
            "description": "Продавец с указанным ID не найден."
          }
        },
        "summary": "Получение всех лотов конкретного продавца",
        "tags": [
          "Lot"
        ]
      }
    },
